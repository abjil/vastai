# wakeup.env.example
# Copy to wakeup.env next to this project (default: /workspace/vastai-wakeup/wakeup.env).
# chmod 600 wakeup.env
# Quote values that contain spaces or special characters.
# Do not commit wakeup.env.

# --- Paths ---
DATA_DIR=/workspace/vastai-wakeup
ACK_FILE=/workspace/vastai-wakeup/ACK
INSTANCE_NAME='vast-gpu'

# --- Loop ---
# First wait between alerts, then doubles until INTERVAL_MAX_SEC.
INTERVAL_SEC=60
INTERVAL_MAX_SEC=900
# How often to notice ACK while sleeping.
ACK_POLL_SEC=5
# 0 = never give up sending (only slow down). Set e.g. 50 to cap sends.
MAX_ALERTS=0
# 1 = render only, do not send
WAKEUP_DRY_RUN=0

# --- Public SMTP (send_email_from_template.sh) ---
# Gmail: app password, smtp.gmail.com:587 STARTTLS.
# Datacenter IPs are often spam-foldered; pair with Telegram.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_SSL=0
SMTP_USER='you@gmail.com'
SMTP_PASSWORD='replace-with-app-password'
SMTP_FROM='you@gmail.com'
SMTP_FROM_NAME='Vast.ai wakeup'
SMTP_TO='you@gmail.com,other@example.com'
# SMTP_CC=''
# SMTP_BCC=''
SMTP_TIMEOUT=30
EMAIL_SUBJECT='[VAST.AI] instance is UP and billing'

# --- Telegram (recommended) ---
# Create a bot with @BotFather; chat id from @userinfobot or getUpdates.
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''

# --- Twilio SMS (optional) ---
TWILIO_ACCOUNT_SID=''
TWILIO_AUTH_TOKEN=''
TWILIO_FROM=''
SMS_TO=''
